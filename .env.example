DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/boilerplate
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (used by docker-compose postgres service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=boilerplate

# Idempotency (see docs/idempotency.md)
# Backend: redis | memory. "memory" is per-process — a retry served by another
# worker executes again — so it is for tests and single-process development
# only. IDEMPOTENCY_REDIS_URL is optional and falls back to REDIS_URL.
# The reservation TTL must exceed the slowest request this API serves; the
# record TTL is how long a completed response stays replayable.
# FAIL_OPEN=true serves requests without deduplication when the store is down,
# trading exactly-once execution for availability.
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_BACKEND=redis
IDEMPOTENCY_REDIS_URL=
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_RESERVATION_TTL_SECONDS=60
IDEMPOTENCY_MAX_BODY_BYTES=1048576
IDEMPOTENCY_FAIL_OPEN=false

# Distributed locking (see docs/distributed-locking.md)
# Backend: redis | memory. "memory" coordinates callers within one process and
# nothing beyond it — it is for tests and single-process development only.
# DISTRIBUTED_LOCK_REDIS_URL is optional and falls back to REDIS_URL.
# The TTL bounds how long a crashed holder blocks a name; for a section whose
# duration is unpredictable, pass renew_interval to DistributedLock instead of
# raising it. The Redis server holding these keys must not run an allkeys-*
# maxmemory-policy: evicting a fencing counter restarts the tokens.
DISTRIBUTED_LOCK_BACKEND=redis
DISTRIBUTED_LOCK_REDIS_URL=
DISTRIBUTED_LOCK_NAMESPACE=dlock
DISTRIBUTED_LOCK_TTL_SECONDS=30.0

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
AWS_S3_PRESIGNED_URL_EXPIRY=3600

# Object storage backend: s3 | local | memory
# "local" writes under STORAGE_LOCAL_ROOT; "memory" keeps objects in the worker
# process and is for tests only.
STORAGE_BACKEND=s3
STORAGE_LOCAL_ROOT=./var/storage

# Notifications: email | webhook | none
# Fallback for users with no stored preference. NOTIFICATION_WEBHOOK_SECRET is
# the HMAC key webhook receivers verify deliveries with; leave it empty and
# deliveries go out unsigned. ALLOW_PRIVATE_HOSTS must stay false in
# production — true lets a user-supplied webhook URL reach internal addresses.
NOTIFICATION_DEFAULT_CHANNEL=email
NOTIFICATION_WEBHOOK_SECRET=
NOTIFICATION_WEBHOOK_TIMEOUT_SECONDS=10.0
NOTIFICATION_WEBHOOK_MAX_ATTEMPTS=3
NOTIFICATION_WEBHOOK_BACKOFF_SECONDS=0.5
NOTIFICATION_WEBHOOK_ALLOW_PRIVATE_HOSTS=false

# Payments: stripe | paypal
# Only the selected provider's credentials are required. PAYPAL_API_BASE_URL
# defaults to the sandbox — production is https://api-m.paypal.com and must be
# set deliberately, because the wrong value here charges real cards.
PAYMENT_GATEWAY=stripe
PAYMENT_TIMEOUT_SECONDS=15.0
STRIPE_SECRET_KEY=
STRIPE_API_BASE_URL=https://api.stripe.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
