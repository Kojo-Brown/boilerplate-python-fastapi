DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/boilerplate
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (used by docker-compose postgres service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=boilerplate

# Idempotency (see docs/idempotency.md)
# Backend: redis | memory. "memory" is per-process — a retry served by another
# worker executes again — so it is for tests and single-process development
# only. IDEMPOTENCY_REDIS_URL is optional and falls back to REDIS_URL.
# The reservation TTL must exceed the slowest request this API serves; the
# record TTL is how long a completed response stays replayable.
# FAIL_OPEN=true serves requests without deduplication when the store is down,
# trading exactly-once execution for availability.
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_BACKEND=redis
IDEMPOTENCY_REDIS_URL=
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_RESERVATION_TTL_SECONDS=60
IDEMPOTENCY_MAX_BODY_BYTES=1048576
IDEMPOTENCY_FAIL_OPEN=false

# Distributed locking (see docs/distributed-locking.md)
# Backend: redis | memory. "memory" coordinates callers within one process and
# nothing beyond it — it is for tests and single-process development only.
# DISTRIBUTED_LOCK_REDIS_URL is optional and falls back to REDIS_URL.
# The TTL bounds how long a crashed holder blocks a name; for a section whose
# duration is unpredictable, pass renew_interval to DistributedLock instead of
# raising it. The Redis server holding these keys must not run an allkeys-*
# maxmemory-policy: evicting a fencing counter restarts the tokens.
DISTRIBUTED_LOCK_BACKEND=redis
DISTRIBUTED_LOCK_REDIS_URL=
DISTRIBUTED_LOCK_NAMESPACE=dlock
DISTRIBUTED_LOCK_TTL_SECONDS=30.0

# Transactional outbox (see docs/outbox.md)
# There is no switch for writing outbox rows — every domain event is written in
# the transaction that caused it. RELAY_ENABLED decides whether this process
# drains the table: leave it on for a single-deployment setup, or turn it off
# in the API pods and run dedicated relay processes with it on. Any number of
# relays is safe; they claim disjoint batches with FOR UPDATE SKIP LOCKED.
# BATCH_SIZE x DISPATCH_TIMEOUT is the worst case for how long one batch holds
# a database connection and its row locks. POLL_INTERVAL is the delivery
# latency when the queue is empty, and a query per interval per relay.
OUTBOX_RELAY_ENABLED=true
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_DISPATCH_TIMEOUT_SECONDS=30.0
OUTBOX_RETRY_BASE_DELAY_SECONDS=1.0
OUTBOX_RETRY_MAX_DELAY_SECONDS=300.0

# Streaming exports (see docs/streaming.md)
# CHUNK_BYTES x READAHEAD_CHUNKS is the peak memory one in-flight export holds;
# multiply by the concurrent downloads you want to survive. BATCH_ROWS is a
# round-trip knob, not a memory one. DEADLINE_SECONDS bounds how long an export
# may hold a pooled connection and a server-side cursor, including time spent
# waiting on a client that has stopped reading; past it the stream ends with a
# "failed" terminal record instead of an undetectable truncation.
EXPORT_CHUNK_BYTES=65536
EXPORT_READAHEAD_CHUNKS=2
EXPORT_BATCH_ROWS=500
EXPORT_DEADLINE_SECONDS=300.0

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
AWS_S3_PRESIGNED_URL_EXPIRY=3600

# Object storage backend: s3 | local | memory
# "local" writes under STORAGE_LOCAL_ROOT; "memory" keeps objects in the worker
# process and is for tests only.
STORAGE_BACKEND=s3
STORAGE_LOCAL_ROOT=./var/storage

# Notifications: email | webhook | none
# Fallback for users with no stored preference. NOTIFICATION_WEBHOOK_SECRET is
# the HMAC key webhook receivers verify deliveries with; leave it empty and
# deliveries go out unsigned. ALLOW_PRIVATE_HOSTS must stay false in
# production — true lets a user-supplied webhook URL reach internal addresses.
NOTIFICATION_DEFAULT_CHANNEL=email
NOTIFICATION_WEBHOOK_SECRET=
NOTIFICATION_WEBHOOK_TIMEOUT_SECONDS=10.0
NOTIFICATION_WEBHOOK_MAX_ATTEMPTS=3
NOTIFICATION_WEBHOOK_BACKOFF_SECONDS=0.5
NOTIFICATION_WEBHOOK_ALLOW_PRIVATE_HOSTS=false

# Payments: stripe | paypal
# Only the selected provider's credentials are required. PAYPAL_API_BASE_URL
# defaults to the sandbox — production is https://api-m.paypal.com and must be
# set deliberately, because the wrong value here charges real cards.
PAYMENT_GATEWAY=stripe
PAYMENT_TIMEOUT_SECONDS=15.0
STRIPE_SECRET_KEY=
STRIPE_API_BASE_URL=https://api.stripe.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com

# Parallel execution (see docs/parallel-execution.md).
# CPU_POOL_MAX_WORKERS=0 derives the count from this process's actual CPU
# allowance minus one, leaving the event loop a core. uvicorn's own --workers
# multiplies it: four server workers with four pool workers each is sixteen
# child processes, so size it against the container's CPU limit.
# START_METHOD must not be fork — a fork of an async server inherits its open
# database sockets and any lock held by a thread that did not survive it.
# Past MAX_WORKERS * (1 + QUEUE_DEPTH_PER_WORKER) in flight, offloads are
# refused with 503 rather than queued: queued calls hold their pickled
# arguments in memory, so an unbounded queue is an unbounded heap.
CPU_POOL_MAX_WORKERS=0
CPU_POOL_MAX_TASKS_PER_CHILD=100
CPU_POOL_QUEUE_DEPTH_PER_WORKER=4
CPU_POOL_START_METHOD=spawn

# Ceiling on concurrent outbound calls across every fan-out that shares it.
# A per-call limit does not compose, so the real bound lives here.
OUTBOUND_CONCURRENCY_LIMIT=20

# WebSockets (see docs/websockets.md).
# MAX_MESSAGE_BYTES is not the real ceiling on an inbound frame: the ASGI
# server reads and buffers a message before application code sees it, so
# uvicorn's own --ws-max-size (16 MiB by default) is what stops a large frame
# and this only decides what is rejected afterwards. Lower both together.
# IDLE_TIMEOUT_SECONDS is not a liveness check — the protocol's ping/pong is
# handled by the server and has no ASGI message type, so an application cannot
# observe a pong. Clients staying open through a quiet period send this
# endpoint's own {"type":"ping"}.
# MAX_CONNECTION_SECONDS is a ceiling, not the usual lifetime: a connection
# also ends when its access token expires, which at the default
# ACCESS_TOKEN_EXPIRE_MINUTES is far sooner and is the limit most connections
# actually meet.
# The rate limits are per connection, not per address: a WebSocket is one
# request no matter how many messages travel down it, so the middleware
# limiter counts it once and never again. BYTE_BURST must be at least
# MAX_MESSAGE_BYTES, or a maximum-size message could never be afforded.
WS_MAX_MESSAGE_BYTES=65536
WS_MAX_ROOMS_PER_CONNECTION=16
WS_OUTBOUND_BUFFER_MESSAGES=128
WS_IDLE_TIMEOUT_SECONDS=120.0
WS_MAX_CONNECTION_SECONDS=3600.0
WS_MESSAGES_PER_SECOND=10.0
WS_MESSAGE_BURST=30
WS_BYTES_PER_SECOND=262144.0
WS_BYTE_BURST=1048576
WS_MAX_RATE_VIOLATIONS=20
